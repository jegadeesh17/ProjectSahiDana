# OpenRouter API key for online free-text extraction and plain-English explanation (first needed in M2).
# Get a free key at https://openrouter.ai/keys (server-only, never exposed to the browser).
OPENROUTER_API_KEY=

# Primary OpenRouter model identifier used by /api/llm (defaults to openrouter/free, OpenRouter's free-only router, if left empty; use only openrouter/free or ids ending in :free).
# Browse free models at https://openrouter.ai/models?q=:free
OPENROUTER_MODEL=

# Comma-separated fallback OpenRouter models tried on HTTP 429 or upstream errors (defaults to openrouter/free if left empty; duplicates of the primary model are dropped; free models only).
# Browse free models at https://openrouter.ai/models?q=:free
OPENROUTER_FALLBACK_MODELS=

# Per-model timeout in milliseconds for /api/llm (positive integer; defaults to 45000 if left empty or invalid). The whole fallback chain is capped at 55 s.
OPENROUTER_TIMEOUT_MS=

# Client flag: set to true only for prototype fixture mode; leave false (or empty) for the live in-browser LP solver from M1 onward.
VITE_USE_MOCK_ADAPTER=

# Optional Vercel personal access token for CLI deployment in M1 (alternatively run `npx vercel login` interactively).
# Create a token at https://vercel.com/account/tokens
VERCEL_TOKEN=

