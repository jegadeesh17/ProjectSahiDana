{
  "name": "sahidana",
  "private": true,
  "version": "0.1.0",
  "description": "SahiDana: offline-first, auditable dairy ration balancer (Phase 2 clickable prototype on the mock adapter)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "compile:data": "node scripts/compile_data.mjs",
