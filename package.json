{
  "name": "sahidana",
  "private": true,
  "version": "0.1.0",
  "description": "SahiDana: offline-first, auditable regional dairy ration optimizer for field paravets",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "compile:data": "node scripts/compile_data.mjs",
    "eval:dump": "npx vite-node scripts/dump_solver_results.ts",
    "eval:scipy": "python -m pytest -q eval/test_scipy_agreement.py eval/test_scipy_herd_agreement.py",
    "test": "vitest run --exclude \"tests/e2e/**\" --exclude \"**/*.slow.test.ts\"",
    "test:full": "npx vitest run && npx playwright test"
  },
  "dependencies": {
    "@fontsource/noto-sans": "^5.1.0",
    "@fontsource/noto-sans-devanagari": "^5.1.0",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "javascript-lp-solver": "^0.4.24",
    "lucide-react": "^1.49.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.1",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vercel/node": "^3.2.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vite-node": "^2.1.2",
    "vite-plugin-pwa": "^0.20.5",
    "vitest": "^2.1.2"
  }
}
